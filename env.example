# Copiar este archivo a .env.local y completar con tus valores
# cp env.example .env.local

# OpenAI API Key
# Obtener de: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MongoDB Atlas - Produccion
# Obtener de: https://cloud.mongodb.com -> Connect -> Drivers
# IMPORTANTE: La base de datos se llama "banco-ideas" (sin "de")
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/banco-ideas?retryWrites=true&w=majority&appName=bancodeideas

# MongoDB Atlas - Pruebas (opcional, para testing local)
MONGODB_URI_PRUEBAS=mongodb+srv://usuario:password@cluster.mongodb.net/banco-ideas-pruebas?retryWrites=true&w=majority&appName=bancodeideas
