# Copiar este archivo a .env.local y completar con tus valores
# cp env.example .env.local

# DeepSeek API Key (chat/análisis de ideas)
# Obtener de: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=

# OpenAI API Key (lectura en voz alta con gpt-4o-mini-tts, y embeddings)
# Obtener de: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (Claude Opus 5 — gestor del espacio privado)
# Obtener de: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# MongoDB Atlas - Produccion
# Obtener de: https://cloud.mongodb.com -> Connect -> Drivers
# IMPORTANTE: La base de datos se llama "banco-ideas" (sin "de")
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/banco-ideas?retryWrites=true&w=majority&appName=bancodeideas

# MongoDB Atlas - Pruebas (opcional, para testing local)
MONGODB_URI_PRUEBAS=mongodb+srv://usuario:password@cluster.mongodb.net/banco-ideas-pruebas?retryWrites=true&w=majority&appName=bancodeideas

# Aviso por mail al admin cuando OTRA persona publica una idea
# (lib/notifications/notifyAdminNewIdea.ts). Sólo la API key es obligatoria;
# si falta, no se manda nada y sólo se deja un console.warn.
# Obtener la API key de: https://resend.com/api-keys  (también se acepta como RESEND)
RESEND_API_KEY=
# Destinatario(s) del aviso, separados por coma. Por defecto: OWNER_EMAIL (lib/owner.ts)
NOTIFY_EMAIL_TO=
# Remitente. Por defecto "Banco de Ideas <onboarding@resend.dev>", que sólo
# entrega al email dueño de la cuenta de Resend. Para producción usar un
# dominio verificado en Resend, ej: Banco de Ideas <avisos@unbancodeideas.com>
NOTIFY_EMAIL_FROM=
# Identidad del admin: sus propias ideas no generan aviso.
# ADMIN_USER_ID es el _id del usuario en la colección `users` (session.user.id)
# ADMIN_EMAIL por defecto: OWNER_EMAIL (lib/owner.ts)
ADMIN_USER_ID=
ADMIN_EMAIL=
# URL base del sitio, sin barra final, para el link a la idea en el mail.
# Si falta, se usa la URL del despliegue de Vercel (VERCEL_URL).
NEXT_PUBLIC_SITE_URL=https://www.unbancodeideas.com
